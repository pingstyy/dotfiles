{
  "local function": {
    "prefix": "lfn",
    "description": "local Lua function",
    "body": [
      "local function ${1:name}(${2:args})",
      "    ${0}",
      "end"
    ]
  },
  "module function": {
    "prefix": "mfn",
    "description": "Lua module function",
    "body": [
      "function M.${1:name}(${2:args})",
      "    ${0}",
      "end"
    ]
  }
}
